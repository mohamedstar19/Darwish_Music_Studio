# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created on first start if no admin exists.
ADMIN_EMAIL=admin@darwish-tech.com
ADMIN_PASSWORD=change-me-too

# Secret admin panel URL: https://dms.darwish-tech.com/<ADMIN_PATH>
# Use a long random value, e.g.  dms-$(openssl rand -hex 12)
ADMIN_PATH=change-me-to-a-long-random-path

# Port on the server (http://192.168.1.116:8095)
APP_PORT=8095

# Where audio files and covers are stored on the host (can be a TrueNAS mount).
MEDIA_PATH=./data/media

# auto = secure login cookie on https://dms.darwish-tech.com, normal cookie on http://192.168.1.116:8095
COOKIE_SECURE=auto

ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=300
AUDIO_BITRATE=192k

# Android app (Google Play). SHA-256 fingerprints, comma-separated:
# the upload key, plus the "App signing key" shown in Play Console → Test and release → App integrity.
ANDROID_PACKAGE=com.darwishtech.dms
ANDROID_SHA256=

# Cloudflare Tunnel token for dms.darwish-tech.com (optional, see README).
CLOUDFLARE_TUNNEL_TOKEN=

# Recognise songs by their sound (AcoustID). Free "Application API key" from
# https://acoustid.org/new-application . Optional: it can also be set in the admin panel.
ACOUSTID_KEY=

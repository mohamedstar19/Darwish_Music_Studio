# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created on first start if no admin exists.
ADMIN_EMAIL=admin@darwish-tech.com
ADMIN_PASSWORD=change-me-too

# Port on the server (http://192.168.1.116:8095)
APP_PORT=8095

# Where audio files and covers are stored on the host (can be a TrueNAS mount).
MEDIA_PATH=./data/media

# Set to true when the site is served over HTTPS (e.g. https://dms.darwish-tech.com).
COOKIE_SECURE=false

ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=300
AUDIO_BITRATE=192k

# Cloudflare Tunnel token for dms.darwish-tech.com (optional, see README).
CLOUDFLARE_TUNNEL_TOKEN=
